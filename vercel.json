{
  "functions": {
    "src/api/*.py": {
      "runtime": "vercel-python@4.3.1",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/upload", "destination": "/src/api/upload.py" },
    { "source": "/api/ingest", "destination": "/src/api/ingest.py" },
    { "source": "/api/query",  "destination": "/src/api/query.py"  }
  ]
}
